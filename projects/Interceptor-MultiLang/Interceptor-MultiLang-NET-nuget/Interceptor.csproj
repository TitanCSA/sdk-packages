<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Interceptor.MultiLang</PackageId>
    <Version>1.0.2</Version>
    <Description>Minimal .NET bindings for the Interceptor Windows input filter driver</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit>049d233b204acc89996237cc29ea4fd26464a61e</RepositoryCommit>
    <PackageTags>windows interceptor input native keyboard mouse gamepad</PackageTags>
    <PackageReleaseNotes>Windows error 2 now names the separate InterceptorSetup.exe installer and the Install.cmd option available in the full ZIP.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/TitanCSA/Interceptor-MultiLang</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TitanCSA/Interceptor-MultiLang</PackageProjectUrl>
    <Authors>TitanCSA</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <None Include="runtimes/win-x64/native/InterceptorBridge.dll" Link="InterceptorBridge.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes/win-x64/native/InterceptorBridge.dll')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs/**/*.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
