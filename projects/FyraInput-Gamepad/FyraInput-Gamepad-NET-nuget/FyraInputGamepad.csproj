<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>FyraInputGamepadProductSDK</AssemblyName><TargetFramework>net8.0</TargetFramework><AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PackageId>FyraInputGamepad.SDK</PackageId><Version>1.0.0</Version><Description>Direct .NET bindings to the FyraInput-Gamepad Windows SDK</Description><PackageLicenseExpression>MIT</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile><RepositoryUrl>https://github.com/TitanCSA/FyraInput-Gamepad-SDK</RepositoryUrl><PackageProjectUrl>https://github.com/TitanCSA/FyraInput-Gamepad-SDK</PackageProjectUrl><Authors>TitanCSA</Authors><GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>$(NoWarn);1591</NoWarn></PropertyGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="/" /><None Include="LICENSE" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup><None Include="runtimes/win-x64/native/FyraInputGamepadBridge.dll" Link="FyraInputGamepadBridge.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes/win-x64/native/FyraInputGamepadBridge.dll')" /></ItemGroup>
<ItemGroup><None Include="docs/**/*.md" Pack="true" PackagePath="docs/" /></ItemGroup></Project>